{
    "name": "marque/threepio",
    "description": "BitTorrent protocol primitives for Marque platform",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Letter Of Marque Software",
            "email": "dan@lom.software",
            "homepage": "https://lom.software"
        }
    ],
    "support": {
        "issues": "https://github.com/letterofmarque/marque/issues",
        "source": "https://github.com/letterofmarque/marque"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/redis": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7",
        "mockery/mockery": "^1.6",
        "laravel/pao": "^1.1"
    },
    "suggest": {
        "ext-redis": "Required to reach a Redis server, unless you install predis/predis instead. Every deployment that serves announces needs one of the two — peer storage is Redis, not Laravel's cache, and the announce path fatals without a working connection.",
        "predis/predis": "Pure-PHP alternative to ext-redis. Either satisfies Laravel's REDIS_CLIENT; pick one."
    },
    "autoload": {
        "psr-4": {
            "Marque\\Threepio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marque\\Threepio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.x-dev"
        },
        "laravel": {
            "providers": [
                "Marque\\Threepio\\ThreepioServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
